{
  "description": "Report CodeBuddy Code agent state to Herdr",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CODEBUDDY_PLUGIN_ROOT}/scripts/herdr-agent.sh\" start",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CODEBUDDY_PLUGIN_ROOT}/scripts/herdr-agent.sh\" working",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CODEBUDDY_PLUGIN_ROOT}/scripts/herdr-agent.sh\" working",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CODEBUDDY_PLUGIN_ROOT}/scripts/herdr-agent.sh\" blocked",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CODEBUDDY_PLUGIN_ROOT}/scripts/herdr-agent.sh\" blocked",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CODEBUDDY_PLUGIN_ROOT}/scripts/herdr-agent.sh\" idle",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CODEBUDDY_PLUGIN_ROOT}/scripts/herdr-agent.sh\" idle",
            "timeout": 5
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CODEBUDDY_PLUGIN_ROOT}/scripts/herdr-agent.sh\" idle",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CODEBUDDY_PLUGIN_ROOT}/scripts/herdr-agent.sh\" release",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
